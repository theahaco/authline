# Dev against TESTNET — `npm run dev:testnet` (vite --mode testnet).
# `npm run dev` uses `stellar scaffold watch`, whose development network is the
# local Standalone network (NET_TAG=LOCAL), where the onboard router and assets
# are NOT deployed/pinned — so activation is unavailable there. Testnet has the
# router + USDC + TLO pinned, so use this to actually exercise the dApp.
# Overrides the committed .env (mainnet) for vite's `testnet` mode.
PUBLIC_STELLAR_NETWORK="TESTNET"
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
# The regulated one-step path against the pinned testnet EURCV test token
# (AUTH_REQUIRED; authorizer-stub is its SAC admin). Comment out to fall back
# to USDC (open), or set "TLO" for the older EURCV-style test token.
PUBLIC_ASSET_CODE="EURCV"
