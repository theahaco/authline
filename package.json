{
  "name": "scaffold-stellar-frontend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "prestart": "npm run build -w @theaha/authline",
    "start": "concurrently --kill-others-on-fail --names stellar,vite -c gray,green --pad-prefix \"stellar scaffold watch --build-clients\" \"vite\"",
    "build": "npm run build -w @theaha/authline && tsc -b && vite build",
    "build:e2e": "npm run build -w @theaha/authline && tsc -b && vite build --mode e2e",
    "install:contracts": "if ls packages/*/package.json >/dev/null 2>&1; then npm run build --workspaces --if-present; else echo 'No contract client packages present; skipping install:contracts.'; fi",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc",
    "deploy:testnet-sac": "node scripts/deploy-testnet-usdc-sac.mjs",
    "test:e2e:testnet": "RUN_TESTNET_E2E=1 vitest run tests/e2e/testnet-usdc.e2e.test.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@stellar/stellar-sdk": "^14.4.3",
    "@stellar/stellar-xdr-json": "^23.0.0",
    "@theaha/authline": "^0.2.0",
    "@theahaco/ts-config": "^1.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.6"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ]
  },
  "prettier": "@theahaco/ts-config/prettier"
}
