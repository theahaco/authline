# Playwright build env for the REGULATED (AUTH_REQUIRED) path on testnet.
# Loaded by `vite build --mode e2e-tlo` (see build:e2e:tlo). The live asset is
# the pinned testnet test token TLO; its issuer/SAC/authorizer/capability resolve
# from the SDK registry, so only the code + network + router are set here.
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
PUBLIC_ASSET_CODE="TLO"
PUBLIC_ROUTER="CABVVUYHXS6UVN2VYYXKEUO2XEJIAGMTEYF2BOWGUUJVOO2IGPRWZAX4"
