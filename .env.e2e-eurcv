# Playwright build env for the REGULATED (AUTH_REQUIRED) path on testnet using
# the pinned testnet EURCV test token. Loaded by `vite build --mode e2e-eurcv`
# (see build:e2e:eurcv). The issuer/SAC/authorizer/capability resolve from the
# SDK registry pin, so only the code + network + router are set here.
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
PUBLIC_ASSET_CODE="EURCV"
PUBLIC_ROUTER="CABVVUYHXS6UVN2VYYXKEUO2XEJIAGMTEYF2BOWGUUJVOO2IGPRWZAX4"
